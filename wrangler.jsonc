// Cloudflare: build xong thì đưa thư mục _site lên mạng.
// worker/index.js lo phần đăng ký email, thanh toán, phòng học.
{
  "name": "maybejoy",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/hoc/*", "/quan-ly", "/quan-ly/*"]
  },
  // Nơi lưu đơn hàng và email đăng ký. Lần deploy đầu Cloudflare tự tạo.
  "kv_namespaces": [{ "binding": "DB" }],
  "vars": {
    "EMAIL_MAY": "phung.p.vn@gmail.com"
  },
  "observability": { "enabled": true }
}
