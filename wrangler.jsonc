// Cloudflare: build xong thì đưa thư mục _site lên mạng.
// worker/index.js lo phần đăng ký email, thanh toán, phòng học.
{
  "name": "maybejoy",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Worker chạy trước mọi trang (để nhìn tên miền mayphung.com hay yeswithmay.com),
    // trừ /assets/ (ảnh, css, phông, pdf) đi thẳng, không tốn lượt chạy Worker.
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // Nơi lưu đơn hàng và email đăng ký. Lần deploy đầu Cloudflare tự tạo.
  "kv_namespaces": [{ "binding": "DB" }],
  "vars": {
    "EMAIL_MAY": "phung.p.vn@gmail.com"
  },
  "observability": { "enabled": true },
  // Thư báo cáo tuần: 01:00 giờ quốc tế thứ Hai = 8 giờ sáng thứ Hai ở Việt Nam
  "triggers": { "crons": ["0 1 * * 1"] }
}
