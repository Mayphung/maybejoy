---
layout: base.njk
title: Mẹ cũng đang học
description: 'Những bài viết của May về chuyện làm mẹ, hiểu con và hiểu cả những điều mình mang theo từ ngày còn bé. Viết kỹ, để đọc lúc nhà đã yên.'
permalink: /me-cung-dang-hoc/
css: me
bodyClass: p-me
navKey: me-cung-dang-hoc
---
{% from "macros.njk" import mform with context %}
{% set m = meCungDangHoc %}
{% set baiMe = collections.posts | byCategory("me-cung-dang-hoc") %}
{% set noiBat = baiMe | featured %}
<div class="wrap">
  {% include "nav.njk" %}
  <hr class="rule">

  <header class="head" id="noi-dung">
    <div class="serif sub-line">hiên nhà</div>
    <h1 class="serif h1">Mẹ <span style="font-style: italic">cũng đang</span> học</h1>
    <p style="font-size: 19px; max-width: 640px; margin: 0 auto">{{ m.loiMoDau }}</p>
  </header>

  <div class="g3 promises">
    {% for c in m.cachDoc %}
    <div style="display: flex; gap: 16px"><span class="serif" style="font-size: 34px; line-height: 1; color: #C1653A; font-style: italic">{{ loop.index }}</span><div><b style="font-weight: 600; color: #6E2A34">{{ c.ten }}</b><br><span style="font-size: 15px">{{ c.moTa }}</span></div></div>
    {% endfor %}
  </div>

  {% if noiBat %}
  <div class="kick" style="margin-bottom: 18px">Bài mới nhất</div>
  <a class="feat" href="{{ noiBat.url }}">
    <img src="{{ noiBat.data.image or '/assets/images/me-om-con-cua-so.jpg' }}" alt="{{ noiBat.data.imageAlt or '' }}">
    <div class="feat-body">
      {% set t0 = m.the | findBy("key", (noiBat.data.the or [])[0]) %}
      <div class="kick" style="margin-bottom: 14px">{% if t0 %}{{ t0.ten }} · {% endif %}{{ noiBat.content | readMin }} phút đọc</div>
      <h2 class="serif" style="font-size: 34px; line-height: 1.3; margin: 0 0 18px; color: #6E2A34; font-weight: 600">{{ noiBat.data.title }}</h2>
      {% if noiBat.data.excerpt %}<p style="margin: 0 0 24px; font-size: 16px">{{ noiBat.data.excerpt }}</p>{% endif %}
      <span style="font-weight: 500; color: #6E2A34; border-bottom: 1.5px solid #C1653A; align-self: flex-start; font-size: 14px">Đọc bài</span>
    </div>
  </a>
  {% endif %}

  <section style="margin-top: 110px" aria-labelledby="ds-h">
    <div style="text-align: center; margin-bottom: 40px">
      <h2 id="ds-h" class="serif" style="font-size: 40px; line-height: 1.25; margin: 0; color: #6E2A34; font-weight: 500">{{ m.tieuDeDanhSach | mdInline | safe }}</h2>
    </div>
    <div class="g3 doors" role="group" aria-label="Lọc theo điều bạn đang cần">
      {% for t in m.the %}
      <button class="door-f" type="button" data-the="{{ t.key }}" aria-pressed="false">
        {% if t.anh %}<img src="{{ t.anh }}" alt="{{ t.moTaAnh }}" loading="lazy">{% endif %}
        <span class="dt">{{ t.ten }}</span>
        <span class="dd">{{ t.moTa }}</span>
        <span class="dn">{{ baiMe | byTag(t.key) | length }} bài</span>
      </button>
      {% endfor %}
    </div>
    <div class="list-top">
      <button class="chip-all on" type="button" data-the="all" aria-pressed="true">Toàn bộ</button>
      <span class="hand" id="the-line" aria-live="polite"></span>
    </div>
    <div class="me-list">
      {% for b in baiMe %}
      <a class="me-row" href="{{ b.url }}" data-the="{{ (b.data.the or []) | join(' ') }}">
        <span class="tags">{% for k in b.data.the or [] %}{% set tt = m.the | findBy("key", k) %}{% if tt %}<span class="tg">{{ tt.ten }}</span>{% endif %}{% endfor %}</span>
        <span class="t">{{ b.data.title }}</span>
        {% if b.data.excerpt %}<span class="e">{{ b.data.excerpt }}</span>{% endif %}
        <span class="m">{{ b.date | dateDots }} · {{ b.content | readMin }} phút đọc</span>
      </a>
      {% endfor %}
    </div>
    <div class="more-wrap"><button class="btn-more" type="button" id="me-more" hidden>Đọc tiếp</button></div>
  </section>

  <section class="g2 try-sec">
    <div>
      <h2 class="serif" style="font-size: 38px; line-height: 1.25; margin: 0 0 14px; color: #6E2A34; font-weight: 500">Một việc nhỏ, <span style="font-style: italic">thử tối nay.</span></h2>
      <p style="margin: 0; font-size: 16px">{{ m.thuToiNayGiaiThich }}</p>
    </div>
    <div class="try" style="margin: 0">
      <div class="lbl">thử tối nay</div>
      {{ m.viDuThuToiNay | md | safe }}
    </div>
  </section>

  <section class="signup">
    <h2 class="serif" style="font-size: 36px; line-height: 1.25; margin: 0 0 26px; color: #6E2A34; font-weight: 500">Cùng May học nhé!</h2>
    {{ mform("em-me", "Email của bạn", "Gửi cho mình", "chung", "margin: 0 auto; justify-content: center") }}
  </section>

  {% include "foot.njk" %}
</div>
