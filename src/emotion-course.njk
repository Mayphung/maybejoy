---
layout: base.njk
title: Khoảng Dừng Cảm Xúc
description: 'Khoảng Dừng Cảm Xúc — 14 bài video ngắn và một workbook thực hành của May, giúp bạn hiểu cảm xúc của mình và chọn cách phản ứng, thay vì bị nó cuốn đi. Hoàn tiền 7 ngày.'
image: /assets/images/di-vao-suong.jpg
permalink: /khoang-dung-cam-xuc/
css: khoang
bodyClass: p-kd
navKey: o-xuong-may
---
{% from "macros.njk" import mform with context %}
{% set k = khoangDung %}
{% set L = khoangDung.chu %}
{% set sp = banHang.sanPham | findBy("ma", "emotion-course") %}
{% set moBan = banHang.nganHang.soTaiKhoan %}
{% set giaChu = sp.gia | vnd %}
{% set cta %}{% if moBan %}<a class="btn kd-cta" href="/thanh-toan/?sp=emotion-course">{{ L.nutMua | replace("{ten}", k.ten) | replace("{gia}", giaChu) }}</a>{% else %}<a class="btn kd-cta" href="#gia">{{ L.nutChuaMo }}</a>{% endif %}{% endset %}

<div class="wrap">{% include "nav.njk" %}</div>

<main id="noi-dung">

{# ===== 1. Mở đầu ===== #}
<section class="kd-hero">
  <div class="kd-hero-text">
    <div class="kd-kick">{{ L.dongNho }}</div>
    <h1>{{ k.ten }}</h1>
    <p class="kd-sub">{{ k.moTaNgan }}</p>
    <ul class="kd-meta">{% for m in k.dongMeta %}<li>{{ m }}</li>{% endfor %}</ul>
    <div class="kd-price-line">
      <span class="now">{{ giaChu }}</span>
      <span class="later">{{ L.sauDo }} <s>{{ sp.giaSau | vnd }}</s></span>
      <span class="tag hand">{{ L.giaKhoiDiem }}</span>
    </div>
    <div class="kd-hero-cta">{{ cta | safe }}</div>
    <p class="kd-small">{{ k.ghiChuMua }}</p>
  </div>
  <figure class="kd-hero-photo">
    <img src="{{ k.anhDau }}" alt="{{ k.anhDauMoTa }}" width="900" height="1200" fetchpriority="high">
    <figcaption class="hand">{{ k.anhDauGhiTay }}</figcaption>
  </figure>
</section>

{# ===== 2. Cái móc ===== #}
<section class="kd-hook">
  <p class="kd-big">{{ k.moDau | mdInline | safe }}</p>
  <p class="kd-hook-more">{{ k.moDauThem }}</p>
  <p class="kd-hook-intro">{{ k.gioiThieu | mdInline | safe }}</p>
</section>

{# ===== 3. Nghe quen không? ===== #}
<section class="kd-quen" aria-labelledby="quen-h">
  <h2 id="quen-h">{{ L.ngheQuenTieuDe }}</h2>
  <p class="kd-quen-hint hand">{{ L.ngheQuenGoiY }}</p>
  <ul class="kd-quen-list">
    {% for q in k.ngheQuen %}
    <li><button class="kd-q" type="button" aria-pressed="false"><span class="t">{{ q.nhan }}</span><span class="c">{{ q.chu | mdInline | safe }}</span><span class="nod" aria-hidden="true">{{ L.ngheQuenNhan }}</span></button></li>
    {% endfor %}
  </ul>
  <p class="kd-quen-count hand" id="kd-dem" aria-live="polite"></p>
  <div class="kd-not-you">
    <p class="kd-big">{{ k.khongPhaiLoiBan | mdInline | safe }}</p>
    {% for p in k.khongPhaiLoiBanThem %}<p>{{ p }}</p>{% endfor %}
  </div>
</section>

{# ===== 4. Mang theo gì ===== #}
<section class="kd-bag" aria-labelledby="bag-h">
  <div class="kd-wrap">
    <h2 id="bag-h">{{ L.mangTheoTieuDe | mdInline | safe }}</h2>
    <p class="kd-lead">{{ k.mangTheo | mdInline | safe }}</p>
    <ol class="kd-bag-list">
      {% for m in k.mangTheoDs %}
      <li><span class="n">{{ loop.index }}</span><strong>{{ m.ten }}</strong><span>{{ m.moTa }}</span></li>
      {% endfor %}
    </ol>
  </div>
</section>

{# ===== 5. Nhịp 5 bước ===== #}
<section class="kd-rhythm" id="nhip" aria-labelledby="nhip-h">
  <div class="kd-wrap">
    <div class="kd-kick light">{{ L.nhipNhan }}</div>
    <h2 id="nhip-h">{{ L.nhipTieuDe }}</h2>
    <div class="kd-breath" aria-hidden="true"><div class="ring"></div><div class="ring r2"></div><span class="lbl" id="kd-breath-lbl">dừng</span></div>
    <ol class="kd-steps" id="kd-steps">
      {% for n in k.nhip %}
      <li{% if loop.first %} class="on"{% endif %}><button type="button"><span class="i">{{ loop.index }}</span><span class="t">{{ n.ten }}</span></button><p>{{ n.moTa }}</p></li>
      {% endfor %}
    </ol>
    <p class="kd-rhythm-note">{{ k.nhipGhiChu }}</p>
    <button class="kd-try" type="button" id="kd-try">{{ L.nutThuTho }}</button>
  </div>
</section>

{# ===== 6. 14 bài, 4 chặng ===== #}
<section class="kd-path" aria-labelledby="path-h">
  <div class="kd-wrap">
    <h2 id="path-h">{{ L.changTieuDe | mdInline | safe }}</h2>
    <p class="kd-lead">{{ L.changLoi }}</p>
    <div class="kd-trail">
      {% for c in k.chang %}
      <div class="kd-stage{% if c.so == 'III' %} dark{% endif %}">
        <div class="kd-stage-head">{% if c.so %}<span class="roman">Chặng {{ c.so }}</span>{% endif %}<h3>{{ c.ten }}</h3></div>
        {% if c.ghiChu %}<p class="kd-stage-note hand">{{ c.ghiChu }}</p>{% endif %}
        <ul>
          {% for b in c.bai %}
          <li><span class="ep">{{ b.so }}</span><div><strong>{{ b.ten }}</strong><span>{{ b.moTa }}</span></div></li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# ===== 7. Workbook ===== #}
<section class="kd-wb" aria-labelledby="wb-h">
  <div class="kd-wrap kd-wb-grid">
    <figure class="kd-wb-photo">
      <img src="{{ k.anhWorkbook }}" alt="{{ k.anhWorkbookMoTa }}" loading="lazy" width="800" height="1066">
    </figure>
    <div>
      <h2 id="wb-h">{{ L.workbookTieuDe | mdInline | safe }}</h2>
      <p>{{ k.workbook | mdInline | safe }}</p>
      <ul class="kd-tabs">{% for w in k.workbookDs %}<li>{{ w }}</li>{% endfor %}</ul>
      <p class="hand kd-wb-note">{{ k.workbookGhiTay }}</p>
    </div>
  </div>
</section>

{# ===== 8. Cảm nhận (chỉ hiện khi đã có) ===== #}
{% if k.camNhan and k.camNhan.length %}
<section class="kd-voices" aria-labelledby="voices-h">
  <div class="kd-wrap">
    <h2 id="voices-h">{{ k.camNhanTieuDe | mdInline | safe }}</h2>
    <div class="kd-voice-grid">
      {% for c in k.camNhan %}
      <figure class="kd-voice">
        <blockquote>{{ c.loi }}</blockquote>
        <figcaption>{% if c.anh %}<img src="{{ c.anh }}" alt="" loading="lazy" width="48" height="48">{% endif %}<span><strong>{{ c.ten }}</strong>{% if c.moTa %}<small>{{ c.moTa }}</small>{% endif %}</span></figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# ===== 9. Mình là May ===== #}
<section class="kd-may" aria-labelledby="may-h">
  <div class="kd-wrap kd-may-grid">
    {% if k.anhMay %}
    <div class="kd-may-photos">
      <figure class="kd-may-photo"><img src="{{ k.anhMay }}" alt="{{ k.anhMayMoTa }}" loading="lazy" width="750" height="1000"></figure>
      {% if k.anhMay2 %}
      <figure class="kd-may-polaroid"><img src="{{ k.anhMay2 }}" alt="{{ k.anhMay2MoTa }}" loading="lazy" width="750" height="1000">{% if k.anhMay2GhiTay %}<figcaption class="hand">{{ k.anhMay2GhiTay }}</figcaption>{% endif %}</figure>
      {% endif %}
    </div>
    {% endif %}
    <div>
      <h2 id="may-h">{{ L.veMayTieuDe }}</h2>
      {% for p in k.veMay %}<p>{{ p }}</p>{% endfor %}
      <ul class="kd-creds">{% for c in k.veMayChungChi %}<li>{{ c }}</li>{% endfor %}</ul>
      {% if k.veMayThucHanh %}<p>{{ k.veMayThucHanh }}</p>{% endif %}
      <p class="kd-may-end">{{ k.veMayKet }}</p>
      <p class="signature">{{ site.chu.kyTen or "bit by bit, May" }}</p>
    </div>
  </div>
</section>

{# ===== 10. Hợp với ai ===== #}
<section class="kd-fit" aria-labelledby="fit-h">
  <div class="kd-wrap">
    <h2 id="fit-h">{{ L.choAiTieuDe }}</h2>
    <div class="kd-fit-grid">
      <div class="yes"><h3>{{ L.hopTieuDe }}</h3><ul>{% for h in k.hop %}<li>{{ h }}</li>{% endfor %}</ul></div>
      <div class="no"><h3>{{ L.khongHopTieuDe }}</h3><p>{{ k.khongHop }}</p></div>
    </div>
    <p class="kd-care">{{ k.luuY }}</p>
  </div>
</section>

{# ===== 11. Giá và cam kết ===== #}
<section class="kd-offer" id="gia" aria-labelledby="gia-h">
  <div class="kd-ticket">
    <div class="kd-ticket-main">
      <div class="kd-kick">{{ L.giaNhan }}</div>
      <h2 id="gia-h">{{ k.ten }}</h2>
      <div class="kd-ticket-price"><span class="now">{{ giaChu }}</span><s>{{ sp.giaSau | vnd }}</s></div>
      <p class="per hand">{{ L.moiClip | replace("{gia}", ((sp.gia / 15) / 1000) | round | int + ".000đ") }}</p>
      <ul>{% for n in k.nhanDuoc %}<li>{{ n }}</li>{% endfor %}</ul>
      {% if moBan %}
      {{ cta | safe }}
      {% else %}
      <p class="hand kd-wait">{{ L.choMoLoi }}</p>
      {{ mform("em-kd", "Email của bạn", "Báo mình nhé") }}
      {% endif %}
    </div>
    <div class="kd-seal">
      <div class="kd-seal-badge"><span class="big">7</span><span>ngày</span></div>
      <h3>{{ L.hoanTienTieuDe }}</h3>
      <p>{{ k.hoanTien }}</p>
    </div>
  </div>
</section>

{# ===== 12. Hỏi đáp ===== #}
<section class="kd-faq" aria-labelledby="faq-h">
  <div class="kd-wrap">
    <h2 id="faq-h">{{ L.hoiDapTieuDe }}</h2>
    {% for q in k.hoiDap %}
    <details><summary>{{ q.hoi }}</summary><p>{{ q.dap }}</p></details>
    {% endfor %}
  </div>
</section>

{# ===== 13. Kết ===== #}
<section class="kd-end">
  <div class="kd-wrap">
    {% for p in k.ket %}<p>{{ p }}</p>{% endfor %}
    <p class="kd-end-hand">{{ L.ketGhiTay }}</p>
    {{ cta | safe }}
  </div>
</section>

</main>

{# Thanh mua dính dưới màn hình (điện thoại) #}
<div class="kd-sticky" id="kd-sticky" hidden>
  <span><strong>{{ giaChu }}</strong><s>{{ sp.giaSau | vnd }}</s></span>
  {% if moBan %}<a class="btn" href="/thanh-toan/?sp=emotion-course">{{ L.thanhDinhNut }}</a>{% else %}<a class="btn" href="#gia">{{ L.thanhDinhNutChuaMo }}</a>{% endif %}
</div>

<div class="wrap">{% include "foot.njk" %}</div>
