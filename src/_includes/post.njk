---
layout: base.njk
css: post
bodyClass: p-post
---
{% from "macros.njk" import mform with context %}
{% set navKey = category %}
{% set cat = site.nav | navItem(category) %}
<div class="wrap">
  {% include "nav.njk" %}
  <article class="article" id="noi-dung">
    <div class="meta">{% if cat %}<a href="{{ cat.url }}">{{ cat.name }}</a> · {% endif %}{{ page.date | dateVi }} · {{ content | readMin }} phút đọc</div>
    <h1>{{ title }}</h1>
    {% if image %}<img class="cover" src="{{ image }}" alt="{{ imageAlt or '' }}">{% endif %}
    <div class="prose">
      {{ content | safe }}
    </div>
    {% if thuToiNay and meCungDangHoc.hienThuToiNay %}
    <aside class="try" aria-label="Thử tối nay">
      <div class="lbl">{{ meCungDangHoc.chu.thuToiNayNhan }}</div>
      {{ thuToiNay | md | safe }}
    </aside>
    {% endif %}
    <p class="signoff">{{ site.chu.kyTen or "bit by bit, May" }}</p>
  </article>

  {% set others = collections.posts | byCategory(category) | without(page.url) | limit(4) %}
  {% if others.length %}
  <nav class="more" aria-label="Đọc tiếp">
    <div class="kick" style="margin-bottom: 6px">{{ site.chu.docTiepTrong }} {{ cat.name if cat else "vở" }}</div>
    {% for p in others %}
    <a href="{{ p.url }}"><span class="t">{{ p.data.title }}</span><span class="c">{{ p.content | readMin }} phút</span></a>
    {% endfor %}
    <a href="/viet/" style="border-bottom: none"><span class="c">{{ site.chu.tatCaBaiMuiTen }}</span></a>
  </nav>
  {% endif %}

  <section class="post-sign">
    <h2 class="script" style="font-size: 40px; line-height: 1.2; margin: 0 0 20px; color: #6E2A34">{{ site.chu.cuoiBaiMoiDangKy }}</h2>
    {{ mform("em-post", site.chu.oEmail, site.chu.nutGui) }}
  </section>

  {% include "foot.njk" %}
</div>
