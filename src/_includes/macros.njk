{#- Form nhận email, gửi về /api/dang-ky. kind: "chung" (bài mới, sách mới…) hoặc "qua" (sổ tay tặng miễn phí) -#}
{% macro mform(id, label, button, kind="chung", style="", inputStyle="") %}
<form class="mform" method="post" action="/api/dang-ky" data-kit="{{ site.kitFormId }}" style="{{ style }}">
  <label for="{{ id }}">{{ label }}
    <input id="{{ id }}" type="email" name="email" placeholder="ten@gmail.com" autocomplete="email" required style="{{ inputStyle }}">
  </label>
  <input type="hidden" name="loai" value="{{ kind }}">
  <button class="btn" type="submit">{{ button }}</button>
</form>
{% if site.chu.dongYEmail %}<p class="mform-cs"{% if style %} style="{{ style }}; margin-top: 8px"{% endif %}>{{ site.chu.dongYEmail }} <a href="/chinh-sach-bao-mat/">{{ site.chu.chinhSach or "Chính sách bảo mật" }}</a></p>{% endif %}
<div class="form-msg" aria-live="polite"></div>
{% endmacro %}
