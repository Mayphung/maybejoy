<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set pageTitle = (title + " · " + site.name) if title else (site.name + " · Ôm mình thật chặt") %}
{% set pageDesc = excerpt or description or site.description %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{{ 'article' if layout == 'post.njk' else 'website' }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:locale" content="vi_VN">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Be+Vietnam+Pro:wght@300;400;500;600&display=swap&subset=vietnamese" rel="stylesheet">
<link rel="stylesheet" href="/assets/style.css">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
</head>
<body>

<nav class="topnav">
  <a class="brand" href="/">{{ site.brand }}</a>
  <div class="links">
    <a href="/" {% if page.url == "/" %}class="active"{% endif %}>Trang Chủ</a>
    <a href="/bit-by-bit/" {% if nav == "bit-by-bit" %}class="active"{% endif %}>Bit by Bit</a>
    <a href="/viet/" {% if nav == "viet" %}class="active"{% endif %}>Viết</a>
    <a href="/ve-may/" {% if nav == "ve-may" %}class="active"{% endif %}>Về May</a>
  </div>
</nav>

{{ content | safe }}

<footer>
  maybejoy.com · Buông Thở Về<br>
  <a href="/emotion-course/">Emotion Course</a> · <a href="/viet/">Viết</a> · <a href="/ve-may/">Về May</a>
</footer>

<script>
  // Lời nhắn khi form email chưa được kết nối (chỉ hiện khi chưa có emailFormAction)
  document.querySelectorAll('form.gift-form[data-pending]').forEach(function (f) {
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      var m = f.parentNode.querySelector('.form-msg');
      if (m) m.textContent = 'Cảm ơn bạn! Phần gửi email đang được kết nối — mình sẽ mở lại ngay khi xong.';
    });
  });
</script>
</body>
</html>
