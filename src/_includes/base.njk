<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = (title + " — May Phung") if title else "May Phung — Bit by Bit, từng chút một" %}
{%- set pageDesc = description or excerpt or site.description %}
{%- set ogImage = (site.url + image) if image else (site.url + "/assets/images/og-maybejoy.jpg") %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc | striptags | truncate(170) }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:site_name" content="May Phung">
<meta property="og:type" content="{{ 'article' if layout == 'post.njk' else 'website' }}">
<meta property="og:title" content="{{ title or 'May Phung — Bit by Bit, từng chút một' }}">
<meta property="og:description" content="{{ pageDesc | striptags | truncate(170) }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ ogImage }}">
<meta property="og:locale" content="vi_VN">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#6E2A34">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Be+Vietnam+Pro:wght@300;400;500;600&family=Patrick+Hand&family=Dancing+Script:wght@500;600;700&display=swap&subset=vietnamese" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/base.css">
{% if css %}<link rel="stylesheet" href="/assets/css/{{ css }}.css">{% endif %}
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
{% if page.url == "/" %}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":"May Phung","url":"{{ site.url }}","inLanguage":"vi","author":{"@type":"Person","name":"May Phung","alternateName":"Phương Phùng","url":"{{ site.url }}/ve-may/"}}</script>
{% endif %}
{% if layout == "post.njk" %}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BlogPosting","headline":{{ title | dump | safe }},"datePublished":"{{ page.date | isoDate }}","inLanguage":"vi","image":"{{ ogImage }}","author":{"@type":"Person","name":"May Phung","url":"{{ site.url }}/ve-may/"},"mainEntityOfPage":"{{ site.url }}{{ page.url }}"}</script>
{% endif %}
</head>
<body class="{{ bodyClass }}">
<a class="skip" href="#noi-dung">Bỏ qua, vào nội dung</a>
{{ content | safe }}
<script src="/assets/js/site.js" defer></script>
{% if js %}<script src="/assets/js/{{ js }}.js" defer></script>{% endif %}
</body>
</html>
