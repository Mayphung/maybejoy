---
layout: base.njk
title: Bit by Bit
nav: bit-by-bit
description: Bit by Bit — May ghi lại, từng chút một, cách mình đi qua những ngày khó mà vẫn giữ lấy giấc mơ.
---
<main>
  <div class="hero">
    <div class="kicker">Từng chút một</div>
    <h1>Bit by Bit</h1>
  </div>
  <div class="intro-prose">
    {% for para in site.bitByBitIntro.split("\n\n") %}<p>{{ para }}</p>{% endfor %}
  </div>

  {% set bb = collections.posts | byCategory("bit-by-bit") %}
  <div class="tier-label">Hành trình</div>
  {% if bb.length %}
  <div class="bb-list">
    {% for p in bb %}
    <a class="bb-card" href="{{ p.url }}">
      <div class="meta">{{ p.date | dateVi }}</div>
      <h3>{{ p.data.title }}</h3>
      <p>{{ p.data.excerpt }}</p>
      <span class="more">Đọc tiếp →</span>
    </a>
    {% endfor %}
  </div>
  {% else %}
  <p class="empty-note">Bài đầu tiên đang được viết…</p>
  {% endif %}

  <div style="margin-top:80px;">{% include "gift.njk" %}</div>
</main>
