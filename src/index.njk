---
layout: base.njk
css: home
bodyClass: p-home
---
{% from "macros.njk" import mform with context %}
{% set t = trangChu %}
{% set C = trangChu.chu %}
{% set check %}<svg class="tick" width="30" height="30" viewBox="0 0 30 30" fill="none" stroke="#A8522B" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 16 L12 24 L27 5"/></svg>{% endset %}
{% set socialMap = { "TikTok": site.social.tiktok, "Facebook": site.social.facebook, "YouTube": site.social.youtube } %}
<div class="vo">
  {% include "nav.njk" %}

  <main class="sheet" id="noi-dung">
    <h1 class="sr-only">May Phung — Bit by Bit</h1>

    <!-- NHÃN VỞ + ẢNH THẺ -->
    <div class="g-top">
      <div class="label">
        <div style="text-align: center; margin-bottom: 14px">
          <div class="script" style="font-size: 64px; line-height: 72px; color: #6E2A34; font-weight: 700">{{ C.tenVo }}</div>
          <div class="hand" style="font-size: 20px; line-height: 24px; color: #A8522B">{{ C.phuDe }}</div>
        </div>
        {% for f in t.nhan %}<div class="field"><b>{{ f.nhan }}:</b><span>{{ f.giaTri }}</span></div>{% endfor %}
      </div>
      {% if t.anhThe %}
      <div class="photo-col">
        <figure class="pol" style="transform: rotate(5deg)">
          <div class="tape"></div>
          <img src="{{ t.anhThe }}" alt="{{ t.anhTheMoTa }}" width="1069" height="1200" fetchpriority="high">
          <figcaption class="hand">{{ t.anhTheChuThich }}</figcaption>
        </figure>
      </div>
      {% endif %}
    </div>

    <p class="hand intro">{{ t.loiChao }}</p>

    <!-- NGÀY THÁNG -->
    <div style="text-align: center; margin: 64px 0 8px">
      <div class="script h-date" id="hom-nay">Hôm nay</div>
      <h2 class="script day-title">{{ C.viecHomNay }}</h2>
    </div>

    <!-- DANH SÁCH VIỆC -->
    <div class="tasks" style="margin-top: 32px">
      <div class="item done" data-i="0" data-default="1">
        <button class="box" type="button" aria-pressed="true" aria-label="Đánh dấu: {{ t.viecDau.viec }}">{{ check | safe }}</button>
        <div>
          <div class="task"><span>{{ t.viecDau.viec }}</span></div>
          <div class="sub">{{ t.viecDau.ghiChu }}</div>
        </div>
        <div></div>
      </div>

      {% for v in t.viecChuyenMuc %}
      {% set c = site.nav | navItem(v.chuyenMuc) %}
      <div class="item" data-i="{{ loop.index }}">
        {% if v.ghiLe %}<div class="margin-note">{{ v.ghiLe }}</div>{% endif %}
        <button class="box" type="button" aria-pressed="false" aria-label="Đánh dấu: {{ v.viec }}">{{ check | safe }}</button>
        <div>
          <div class="task"><span>{{ v.viec }}</span></div>
          <div class="sub">{{ v.ghiChu }}</div>
          {% if c %}<a class="tag" href="{{ c.url }}">{{ c.name }} <span class="serif" style="font-weight: 300; font-style: italic">· {{ c.sub }}</span> →</a>{% endif %}
        </div>
        {% set key = v.chuyenMuc %}{% include "doodle.njk" %}
      </div>
      {% endfor %}

      {% if site.social.tiktok or site.social.facebook or site.social.youtube %}
      <div class="item" data-i="5">
        <button class="box" type="button" aria-pressed="false" aria-label="Đánh dấu: {{ t.viecTheoDoi.viec }}">{{ check | safe }}</button>
        <div>
          <div class="task"><span>{{ t.viecTheoDoi.viec }}</span></div>
          <div class="sub">{{ t.viecTheoDoi.ghiChu }}</div>
          <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 12px">
            {% for name, url in socialMap %}{% if url %}<a class="soc" href="{{ url }}" target="_blank" rel="me noopener" data-tick="5">{{ name }}</a>{% endif %}{% endfor %}
          </div>
        </div>
        <div></div>
      </div>
      {% endif %}

      <!-- việc của bạn -->
      <div class="item mine" data-i="mine">
        <div class="margin-note">{{ C.ghiLeViecBan }}</div>
        <div class="box dashed" aria-hidden="true">{{ check | safe }}</div>
        <div>
          <form class="mine-open" id="mine-form">
            <label class="task" for="viec-cua-ban" style="display: block">{{ C.hoiViecBan }}</label>
            <div style="display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; margin-top: 8px; max-width: 640px">
              <input id="viec-cua-ban" class="inp" type="text" placeholder="{{ C.goiYViecBan }}" maxlength="120" autocomplete="off">
              <button class="btn" type="submit">{{ C.nutGach }}</button>
            </div>
          </form>
          <div class="mine-done" hidden>
            <div class="task"><span id="mine-text"></span></div>
            <div class="sub">{{ C.daGach }} <button type="button" id="mine-undo" class="linkbtn">{{ C.vietViecKhac }}</button></div>
          </div>
        </div>
        <div></div>
      </div>
    </div>

    <!-- KIỂM TRA MIỆNG -->
    {% if kiemTra.hienTrangChu and (kiemTra.bai | ktHien).length %}
    <section style="margin-top: 96px" id="kiem-tra" aria-labelledby="kt-h">
      <h2 class="script sec-h" id="kt-h"><span class="ul">{{ kiemTra.chu.tieuDe }}</span></h2>
      <p class="hand kt-ghi">{{ kiemTra.chu.ghiTay }}</p>
      {% include "kiem-tra-the.njk" %}
    </section>
    {% endif %}

    <!-- TRANG MỚI NHẤT -->
    {% set moi = collections.moiNhat | limit(3) %}
    {% if moi.length %}
    <section style="margin-top: 96px" aria-labelledby="moi-h">
      <h2 class="script sec-h" id="moi-h"><span class="ul">{{ C.baiMoiNhat }}</span></h2>
      <ul class="moi">
        {% for it in moi %}
        {% set c = site.nav | navItem(it.data.category or "tung-chut-mot") %}
        <li>
          <a href="{{ it.url if it.data.title else c.url }}">
            <span class="moi-t">{{ it.data.title or it.data.chu }}</span>
            <span class="moi-m">{% if it.data.title %}{{ it.date | dateDots }} · {% endif %}{{ c.name }} →</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    <!-- BÀI TẬP VỀ NHÀ -->
    <section style="margin-top: 96px" id="bai-tap" aria-labelledby="bt-h">
      <h2 class="script sec-h" id="bt-h"><span class="ul">{{ C.baiTap }}</span></h2>
      <div class="g-hw">
        <div class="hide-s booklet">
          <div style="font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: #F0B892; line-height: 16px">{{ C.nhanCuonNho }}</div>
          <div class="serif" style="font-size: 22px; line-height: 28px; font-weight: 600">{{ t.baiTap.tenSach }}</div>
        </div>
        <div>
          <p style="margin: 0 0 16px; max-width: 600px"><b style="font-weight: 600; color: #6E2A34">{{ C.deBai }}</b> {{ t.baiTap.deBai | mdInline | safe }}</p>
          {{ mform("email-bt", C.oEmail, C.nutGui, "qua", "", "font-family: 'Be Vietnam Pro', sans-serif") }}
        </div>
      </div>
    </section>

    <!-- THỜI KHOÁ BIỂU -->
    {% if site.social.tiktok or site.social.facebook or site.social.youtube %}
    <section style="margin-top: 96px" id="thoi-khoa-bieu" aria-labelledby="tkb-h">
      <h2 class="script sec-h" id="tkb-h" style="margin-bottom: 24px"><span class="ul">{{ C.thoiKhoaBieu }}</span></h2>
      <table class="tkb">
        <thead><tr><th scope="col">{{ C.cotMon }}</th><th scope="col">{{ C.cotNoi }}</th><th scope="col" class="c3">{{ C.cotHoc }}</th><th scope="col"><span class="hide-s">{{ C.cotVao }}</span></th></tr></thead>
        <tbody>
          {% for r in t.thoiKhoaBieu %}{% if socialMap[r.noi] %}
          <tr><td><b style="font-weight: 600; color: #6E2A34">{{ r.mon }}</b></td><td>{{ r.noi }}</td><td class="c3">{{ r.hoc }}</td><td><a href="{{ socialMap[r.noi] }}" target="_blank" rel="me noopener" style="font-weight: 500; display: inline-block; padding: 10px 0">{{ C.vaoLop }}</a></td></tr>
          {% endif %}{% endfor %}
        </tbody>
      </table>
    </section>
    {% endif %}

    <div style="margin-top: 96px">{% include "foot.njk" %}</div>
  </main>
</div>
