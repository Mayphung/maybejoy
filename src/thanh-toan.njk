---
layout: base.njk
title: Thanh toán
permalink: /thanh-toan/
noindex: true
css: post
bodyClass: p-post
navKey: o-xuong-may
---
{% set nh = banHang.nganHang %}
{% set T = banHang.chuThanhToan %}
<div class="wrap">
{% include "nav.njk" %}
<main class="article checkout" id="noi-dung">
  <div class="meta" id="tt-meta">{{ T.dongNho }}</div>
  <h1 id="tt-h">{{ T.tieuDe }}</h1>

  {% if not nh.soTaiKhoan %}
  <div class="prose"><p class="hand" style="font-size: 22px; color: #A8522B">{{ T.chuaMo }}</p></div>
  {% else %}
  {# Bước 1: chọn món, điền email #}
  <form class="co-step" id="tt-form" novalidate>
    <fieldset class="co-pick" id="tt-pick">
      <legend class="sr-only">Chọn món</legend>
      {% for s in banHang.sanPham %}
      <label class="co-opt" data-phong="{{ s.phong }}">
        <input type="radio" name="sp" value="{{ s.ma }}" data-gia="{{ s.gia }}"{% if loop.first %} checked{% endif %}>
        <span class="t">{{ s.ten }}</span>
        <span class="d">{{ s.moTa }}</span>
        <span class="g">{{ s.gia | vnd }}</span>
      </label>
      {% endfor %}
    </fieldset>
    <label class="co-email" for="tt-email">{{ T.oEmail }}
      <input id="tt-email" type="email" name="email" placeholder="ten@gmail.com" autocomplete="email" required>
    </label>
    <p class="co-note">{{ T.ghiChuEmail }}</p>
    <button class="btn" type="submit">{{ T.nutTiep }}</button>
    <div class="form-msg" id="tt-msg" aria-live="polite"></div>
  </form>

  {# Bước 2: quét QR #}
  <section class="co-step" id="tt-qr" hidden aria-live="polite">
    <ol class="steps">
      <li>{{ T.buoc1 }}</li>
      <li>{{ T.buoc2 }} <strong class="co-ma" data-ma></strong></li>
      <li>{{ T.buoc3 }}</li>
    </ol>
    <div class="pay-box">
      <img class="qr" id="tt-qr-img" alt="Mã QR chuyển khoản" width="300" height="300">
      <dl>
        <dt>Ngân hàng</dt><dd>{{ nh.ten }}</dd>
        <dt>Chủ tài khoản</dt><dd>{{ nh.chuTaiKhoan }}</dd>
        <dt>Số tài khoản</dt><dd>{{ nh.soTaiKhoan }}</dd>
        <dt>Số tiền</dt><dd id="tt-gia"></dd>
        <dt>Nội dung</dt><dd><strong data-ma></strong></dd>
      </dl>
    </div>
    <p class="hand co-wait" id="tt-wait">{{ T.dangCho }}<span class="dots">…</span></p>
    <p class="co-note">{{ T.chuaThay }} Mã đơn: <strong data-ma></strong>{% if site.contactEmail %} · <a href="mailto:{{ site.contactEmail }}">{{ site.contactEmail }}</a>{% endif %}</p>
  </section>

  {# Bước 3: xong #}
  <section class="co-step" id="tt-xong" hidden>
    <p class="co-done">{{ T.xongTieuDe }}</p>
    <p>{{ T.xongLoi }}</p>
    <a class="btn" id="tt-vao" href="#">{{ T.xongNut }}</a>
  </section>
  {% endif %}
  <p class="signoff">— May</p>
</main>
{% include "foot.njk" %}
</div>
